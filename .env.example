# ============================================================================
# ADC LIVE WIRING -- put your real credentials in a copy of this file
# named ".env" (not this file itself). Copy it like this:
#
#     cp .env.example .env
#
# Then open .env and paste your keys where marked below. Never commit
# .env to git or share it -- it's your account credentials.
# ============================================================================

# --- Alpaca (broker + market data, paper trading) -------------------------
# Get these free at https://app.alpaca.markets/signup -- sign up, then go to
# "Paper Trading" in the left sidebar, then "API Keys" to generate a pair.
ALPACA_API_KEY=PASTE_YOUR_ALPACA_KEY_HERE
ALPACA_SECRET_KEY=PASTE_YOUR_ALPACA_SECRET_HERE

# --- Portfolio Optimizer API (only needed if you run the REST API) --------
# Make up any random string(s) here yourself -- these are keys YOU issue to
# whoever is allowed to call your API, not keys from a vendor. Comma-separate
# multiple keys if more than one person/system needs access.
# Development-only plaintext API key. In production leave this empty and use
# PORTFOLIO_OPTIMIZER_API_KEY_HASHES instead.
PORTFOLIO_OPTIMIZER_API_KEYS=change-me-to-a-random-string
# Comma-separated SHA-256 digests of API keys for production. Generate with:
# python -c "import hashlib; print(hashlib.sha256(b'YOUR_RANDOM_KEY').hexdigest())"
PORTFOLIO_OPTIMIZER_API_KEY_HASHES=

# --- Which symbols to trade in the live loop -------------------------------
# Comma-separated ticker symbols. Start small (2-5 liquid, well-known names)
# while you're watching how this behaves.
LIVE_TRADING_SYMBOLS=AAPL,MSFT,GOOGL

# --- Position sizing / risk limits -----------------------------------------
LIVE_MAX_POSITION_WEIGHT=0.35
LIVE_LOOKBACK_DAYS=252

# ============================================================================
# PRODUCTION DEPLOYMENT (docker-compose / Dockerfile) -- fill these in when
# actually putting this on a real domain. Everything above this line is for
# the local live-trading loop; everything below is for the served API.
# ============================================================================

# --- Environment ------------------------------------------------------------
# "production" enables HSTS and disables debug-friendly behavior. Leave as
# "development" on your own machine.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS --------------------------------------------------------------------
# REQUIRED if any browser-based frontend (your own site, pricing.html served
# from a different origin, etc.) needs to call this API. Comma-separated,
# no trailing slashes. Left empty, NO cross-origin browser request is
# allowed through -- this is fail-closed on purpose.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- SaaS billing (optional -- only if selling API access) ------------------
PORTFOLIO_OPTIMIZER_SAAS_MODE=0
PORTFOLIO_OPTIMIZER_TENANCY_DB=/app/data/saas_tenancy.db
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_INSTITUTIONAL=

# --- Server sizing (gunicorn_conf.py reads these) ----------------------------
WORKERS=4

# --- Live paper-trading safety gates ------------------------------------
# Set LIVE_EMERGENCY_STOP=1 to block ALL new order submissions immediately.
LIVE_EMERGENCY_STOP=0
LIVE_MAX_DAILY_LOSS_PCT=0.05
LIVE_MAX_DRAWDOWN_PCT=0.15
LIVE_MAX_ORDER_NOTIONAL_PCT=0.35
LIVE_MAX_ORDERS_PER_CYCLE=25
